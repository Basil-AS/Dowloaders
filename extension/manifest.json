{
  "manifest_version": 3,
  "name": "Forum & Article Saver",
  "version": "1.0.0",
  "description": "Сохраняет статьи и комментарии/темы в .txt: Хабр, Reddit, 4PDA, форумы на Discourse (ntc.party и др.).",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Сохранить страницу в .txt",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "forum-article-saver@basil-as.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
